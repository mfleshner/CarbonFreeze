<Window x:Class="SaveSwitch.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SaveSwitch.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=False}"
        Title="Settings"
        Width="560" SizeToContent="Height" MinWidth="480"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.WindowBackground}">

    <StackPanel Margin="16">

        <!-- Store root -->
        <TextBlock Style="{StaticResource Text.Label}" Text="Store root (parked profiles and backups for every game)" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Small}" Margin="6,0,0,0" Content="Default"
                    Command="{Binding ClearStoreRootCommand}" ToolTip="Clear to use the default location" />
            <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="Browse…" Command="{Binding BrowseStoreRootCommand}" />
            <Grid>
                <TextBox x:Name="StoreRootBox" FontFamily="Consolas" Text="{Binding StoreRoot, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock IsHitTestVisible="False" Margin="6,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           Text="{x:Static vm:SettingsViewModel.DefaultStoreRootHint}"
                           Visibility="{Binding Text, ElementName=StoreRootBox, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />
            </Grid>
        </DockPanel>
        <TextBlock Style="{StaticResource Text.Secondary}" FontSize="11" Margin="0,2,0,12"
                   Text="Changing this does not move existing profiles. Move the folder yourself, or switch games back to 'main' first." />

        <!-- Max backups -->
        <TextBlock Style="{StaticResource Text.Label}" Text="Max backups per game (0 = unlimited)" />
        <StackPanel Orientation="Horizontal">
            <TextBox Width="100" Text="{Binding MaxBackupsText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource Text.Error}" Margin="8,0,0,0" VerticalAlignment="Center"
                       Text="{Binding MaxBackupsError}" Visibility="{Binding MaxBackupsError, Converter={StaticResource NullToVis}}" />
        </StackPanel>
        <TextBlock Style="{StaticResource Text.Secondary}" FontSize="11" Margin="0,2,0,12"
                   Text="Oldest zips are pruned once a game has more than this many." />

        <!-- Config path -->
        <TextBlock Style="{StaticResource Text.Label}" Text="Config file" />
        <DockPanel Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="Open" Command="{Binding OpenConfigLocationCommand}"
                    ToolTip="Show the config file in Explorer" />
            <TextBox IsReadOnly="True" FontFamily="Consolas" Background="{StaticResource Brush.StatusBar}" Text="{Binding ConfigPath, Mode=OneWay}" />
        </DockPanel>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" IsDefault="True" Style="{StaticResource Button.Primary}" IsEnabled="{Binding CanAccept}" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
