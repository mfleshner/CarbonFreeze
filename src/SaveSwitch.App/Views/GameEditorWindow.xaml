<Window x:Class="SaveSwitch.App.Views.GameEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SaveSwitch.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:GameEditorViewModel, IsDesignTimeCreatable=False}"
        Title="{Binding Title}"
        Width="640" SizeToContent="Height" MinWidth="560"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.WindowBackground}"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Preset -->
        <DockPanel Grid.Row="0" Margin="{StaticResource Spacing.Field}">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Label}" Margin="0,0,8,0" VerticalAlignment="Center"
                       Text="Use preset:" />
            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name"
                      ToolTip="Fills name, save folder template, Steam App Id and notes from a known game" />
        </DockPanel>

        <StackPanel Grid.Row="1">

            <!-- Name -->
            <TextBlock Style="{StaticResource Text.Label}" Text="Name" />
            <TextBox x:Name="NameBox" Margin="{StaticResource Spacing.Field}"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Template -->
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Small}" Margin="0,0,0,2" Content="Tokens ?"
                        Click="TokensHelp_Click" ToolTip="Show the tokens the template understands" />
                <TextBlock Style="{StaticResource Text.Label}" Text="Save folder template" />
            </DockPanel>
            <Popup x:Name="TokensPopup" StaysOpen="False" Placement="Bottom" PlacementTarget="{Binding ElementName=TemplateBox}"
                   AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{DynamicResource Brush.PaneBackground}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" Padding="10" MaxWidth="560">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,6"
                                   Text="Environment variables like %LOCALAPPDATA% and %USERPROFILE% are expanded, plus these tokens:" />
                        <ItemsControl ItemsSource="{Binding Tokens}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontFamily="Consolas" Text="{Binding Token}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Description}" Style="{StaticResource Text.Secondary}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,6,0,0" FontStyle="Italic"
                                   Text="(No tokens listed: the path expander did not report any.)"
                                   Visibility="{Binding Tokens.Count, Converter={StaticResource ZeroToVis}}" />
                    </StackPanel>
                </Border>
            </Popup>
            <DockPanel Margin="0,0,0,2">
                <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="Browse…" Command="{Binding BrowseTemplateCommand}" />
                <TextBox x:Name="TemplateBox" FontFamily="Consolas"
                         Text="{Binding SavePathTemplate, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>

            <!-- Live preview -->
            <WrapPanel Margin="0,0,0,2">
                <TextBlock Style="{StaticResource Text.Secondary}" Text="Resolves to: " />
                <TextBlock Text="{Binding ResolvedPath}" FontFamily="Consolas"
                           Visibility="{Binding ResolvedPath, Converter={StaticResource NullToVis}}" />
                <TextBlock Margin="6,0,0,0" Text="{Binding ResolveStatusText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResolvedExists}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </WrapPanel>
            <TextBlock Style="{StaticResource Text.Secondary}" FontSize="11" Margin="0,0,0,8"
                       Text="Point this at the folder whose contents are one complete save. SaveSwitch renames that folder when switching." />

            <!-- Template changed warning -->
            <Border Style="{StaticResource Border.Warning}" Margin="0,0,0,8"
                    Visibility="{Binding ShowTemplateChangedWarning, Converter={StaticResource BoolToVis}}">
                <TextBlock Foreground="{DynamicResource Brush.WarningText}"
                           Text="This game already has parked profiles. Changing the template is allowed, but the parked profiles stay where they are and will be swapped into the new location on the next switch." />
            </Border>

            <!-- Steam App Id -->
            <TextBlock Style="{StaticResource Text.Label}" Text="Steam App Id (optional)" />
            <DockPanel Margin="{StaticResource Spacing.Field}">
                <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="Pick from Steam…"
                        Command="{Binding PickFromSteamCommand}" ToolTip="{Binding SteamPickerTooltip}"
                        ToolTipService.ShowOnDisabled="True" />
                <TextBox Width="140" HorizontalAlignment="Left" Text="{Binding SteamAppId, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>

            <!-- Notes -->
            <TextBlock Style="{StaticResource Text.Label}" Text="Notes" />
            <TextBox Margin="{StaticResource Spacing.Field}" Height="64" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Advanced -->
            <Expander Header="Advanced">
                <StackPanel Margin="0,6,0,0">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Store root override (where this game's parked profiles and backups live)" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="Browse…" Command="{Binding BrowseStoreRootCommand}" />
                        <TextBox FontFamily="Consolas" Text="{Binding StoreRootOverride, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Text.Secondary}" FontSize="11" Margin="0,2,0,0"
                               Text="Leave empty to use the global store root from Settings." />
                </StackPanel>
            </Expander>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" IsDefault="True" Style="{StaticResource Button.Primary}"
                    IsEnabled="{Binding CanAccept}" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
