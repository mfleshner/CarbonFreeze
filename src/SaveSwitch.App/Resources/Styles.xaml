<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:SaveSwitch.App.Converters">

    <!-- Converters -->
    <conv:HumanSizeConverter x:Key="HumanSize" />
    <conv:LocalTimeConverter x:Key="LocalTime" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:NullToVisibilityConverter x:Key="NullToVis" />
    <conv:ActiveMarkerConverter x:Key="ActiveMarker" />
    <conv:ZeroToVisibilityConverter x:Key="ZeroToVis" />
    <conv:NotFoundVisibilityConverter x:Key="NotFoundVisibility" />

    <!-- Palette -->
    <SolidColorBrush x:Key="Brush.WindowBackground" Color="#FFF7F7F7" />
    <SolidColorBrush x:Key="Brush.PaneBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Border" Color="#FFD9D9D9" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FF6B6B6B" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF0F6CBD" />
    <SolidColorBrush x:Key="Brush.Error" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FF107C10" />
    <SolidColorBrush x:Key="Brush.WarningBackground" Color="#FFFFF4CE" />
    <SolidColorBrush x:Key="Brush.WarningBorder" Color="#FFE0B400" />
    <SolidColorBrush x:Key="Brush.WarningText" Color="#FF5C4400" />
    <SolidColorBrush x:Key="Brush.StatusBar" Color="#FFEFEFEF" />

    <!-- Spacing -->
    <Thickness x:Key="Spacing.Pane">12</Thickness>
    <Thickness x:Key="Spacing.Field">0,0,0,8</Thickness>
    <Thickness x:Key="Spacing.ButtonRow">0,8,0,0</Thickness>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="Size.ButtonMinWidth">88</sys:Double>

    <!-- Text -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Text.Section" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,8,0,4" />
    </Style>

    <Style x:Key="Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>

    <Style x:Key="Text.Error" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Error}" />
    </Style>

    <Style x:Key="Text.Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>

    <!-- Buttons -->
    <Style TargetType="Button">
        <Setter Property="MinWidth" Value="{StaticResource Size.ButtonMinWidth}" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Button.Small" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <Style x:Key="Button.Link" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inputs -->
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    </Style>

    <Style TargetType="Expander">
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- Lists -->
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="Background" Value="{StaticResource Brush.PaneBackground}" />
        <Setter Property="RowBackground" Value="{StaticResource Brush.PaneBackground}" />
        <Setter Property="AlternatingRowBackground" Value="#FFFAFAFA" />
        <Setter Property="RowHeaderWidth" Value="0" />
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="Background" Value="{StaticResource Brush.PaneBackground}" />
    </Style>

    <!-- Warning banner -->
    <Style x:Key="Border.Warning" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.WarningBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.WarningBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <Style x:Key="Border.Pane" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.PaneBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource Spacing.Pane}" />
    </Style>

</ResourceDictionary>
