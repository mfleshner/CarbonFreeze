<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark palette. Keys must match Light.xaml; ThemeManager swaps the dictionary at runtime. -->
    <SolidColorBrush x:Key="Brush.WindowBackground" Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="Brush.PaneBackground" Color="#FF262626" />
    <SolidColorBrush x:Key="Brush.Border" Color="#FF3D3D3D" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FFA8A8A8" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF5CB8FF" />
    <SolidColorBrush x:Key="Brush.Error" Color="#FFFF6F62" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FF6FCF63" />
    <SolidColorBrush x:Key="Brush.WarningBackground" Color="#FF3A3000" />
    <SolidColorBrush x:Key="Brush.WarningBorder" Color="#FF8C7200" />
    <SolidColorBrush x:Key="Brush.WarningText" Color="#FFFFD966" />
    <SolidColorBrush x:Key="Brush.StatusBar" Color="#FF161616" />
    <SolidColorBrush x:Key="Brush.RowAlternate" Color="#FF2C2C2C" />
    <SolidColorBrush x:Key="Brush.RowSelected" Color="#FF3B4C63" />
    <SolidColorBrush x:Key="Brush.RowSelectedInactive" Color="#FF333B47" />

</ResourceDictionary>
