<Window x:Class="CarbonFreeze.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CarbonFreeze.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        Title="CarbonFreeze"
        Width="1040" Height="680"
        MinWidth="900" MinHeight="560"
        Background="{DynamicResource Brush.WindowBackground}"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <DockPanel>

        <!-- Footer: about line -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.StatusBar}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,4">
            <TextBlock Style="{StaticResource Text.Secondary}" FontSize="11"
                       Text="{x:Static vm:MainViewModel.AboutLine}" />
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.PaneBackground}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       ToolTip="{Binding StatusMessage}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.PaneBackground}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Margin="0" Content="Settings…" Command="{Binding OpenSettingsCommand}" />
                <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" ToolTip="F5" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Add game…" Style="{StaticResource Button.Primary}" Command="{Binding AddGameCommand}" />
                    <Button Content="Edit…" Command="{Binding EditGameCommand}" />
                    <Button Content="Remove" Command="{Binding RemoveGameCommand}"
                            ToolTip="Forget this game. No files are deleted." />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="500" />
            </Grid.ColumnDefinitions>

            <!-- ============================ Left: games ============================ -->
            <Border Grid.Column="0" Style="{StaticResource Border.Pane}" Padding="0">
                <Grid>
                    <ListBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                             BorderThickness="0" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="GamesList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GameViewModel}">
                                <StackPanel Margin="8,6">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Secondary}" FontSize="11"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="16" TextAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasGames, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                               Text="No games yet.&#x0a;&#x0a;Click Add game to register the first one." />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- ============================ Right: selected game ============================ -->
            <Border Grid.Column="2" Style="{StaticResource Border.Pane}">
                <Grid>
                    <!-- Empty state -->
                    <TextBlock Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasSelectedGame, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                               Text="Select a game on the left, or add one." />

                    <DockPanel Visibility="{Binding HasSelectedGame, Converter={StaticResource BoolToVis}}">

                        <!-- Header -->
                        <StackPanel DockPanel.Dock="Top">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Margin="0" Content="Launch" Command="{Binding LaunchCommand}"
                                        ToolTip="Start the game through Steam (requires a Steam App Id)" />
                                <TextBlock Style="{StaticResource Text.Title}" Text="{Binding SelectedGameName}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
                            </DockPanel>

                            <!-- Resolved save path -->
                            <WrapPanel Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource Text.Secondary}" Text="Save folder: " />
                                <Button Style="{StaticResource Button.Link}" Command="{Binding OpenSavePathCommand}"
                                        ToolTip="Open in Explorer"
                                        Visibility="{Binding ResolvedSavePath, Converter={StaticResource NullToVis}}">
                                    <TextBlock Text="{Binding ResolvedSavePath}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                                <Setter Property="TextDecorations" Value="Underline" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SavePathExists}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <TextBlock Style="{StaticResource Text.Error}" Margin="6,0,0,0" Text="(folder not found)">
                                    <TextBlock.Visibility>
                                        <MultiBinding Converter="{StaticResource NotFoundVisibility}">
                                            <Binding Path="ResolvedSavePath" />
                                            <Binding Path="SavePathExists" />
                                        </MultiBinding>
                                    </TextBlock.Visibility>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Text.Error}" Text="{Binding SavePathError}"
                                           Visibility="{Binding SavePathError, Converter={StaticResource NullToVis}}" />
                            </WrapPanel>

                            <!-- Store folder -->
                            <WrapPanel Margin="0,2,0,0">
                                <TextBlock Style="{StaticResource Text.Secondary}" Text="Store folder: " />
                                <Button Style="{StaticResource Button.Link}" Command="{Binding OpenStoreFolderCommand}"
                                        ToolTip="Parked profiles and backups for this game. Open in Explorer">
                                    <TextBlock Text="{Binding StorePath}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Brush.Accent}" TextDecorations="Underline" />
                                </Button>
                            </WrapPanel>

                            <!-- Steam Cloud banner -->
                            <Border Style="{StaticResource Border.Warning}"
                                    Visibility="{Binding ShowCloudWarning, Converter={StaticResource BoolToVis}}">
                                <TextBlock Foreground="{DynamicResource Brush.WarningText}"
                                           Text="{x:Static vm:MainViewModel.SteamCloudWarning}" />
                            </Border>

                            <TextBlock Style="{StaticResource Text.Section}" Text="Profiles" />
                        </StackPanel>

                        <!-- Profile buttons -->
                        <WrapPanel DockPanel.Dock="Top" Margin="{StaticResource Spacing.ButtonRow}">
                            <WrapPanel.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Margin" Value="0,0,6,6" />
                                </Style>
                            </WrapPanel.Resources>
                            <Button Content="Switch to selected" Style="{StaticResource Button.Primary}" Margin="0,0,6,6"
                                    Command="{Binding SwitchToSelectedCommand}" ToolTip="Enter" />
                            <Button Content="New profile…" Command="{Binding NewProfileCommand}" />
                            <Button Content="Rename…" Command="{Binding RenameProfileCommand}" />
                            <Button Content="Delete…" Command="{Binding DeleteProfileCommand}" ToolTip="Delete key. A zip backup is kept." />
                            <Button Content="Backup now" Command="{Binding BackupNowCommand}" />
                        </WrapPanel>

                        <!-- Backups -->
                        <Expander DockPanel.Dock="Bottom" Header="Backups" IsExpanded="False" Margin="0,8,0,0">
                            <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Style="{StaticResource Button.Small}" Margin="0,0,0,4"
                                    Content="Open backups folder" Command="{Binding OpenBackupsFolderCommand}" ToolTip="{Binding BackupPath}" />
                            <Grid MaxHeight="180">
                                <DataGrid x:Name="BackupsGrid" ItemsSource="{Binding Backups}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Profile" Binding="{Binding ProfileName}" Width="*" />
                                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedUtc, Converter={StaticResource LocalTime}}" Width="140" />
                                        <DataGridTextColumn Header="Size" Binding="{Binding SizeBytes, Converter={StaticResource HumanSize}}" Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                    <Setter Property="Margin" Value="0,0,6,0" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource Button.Small}" Content="Open folder" Margin="4,1"
                                                            Command="{Binding DataContext.OpenBackupLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Style="{StaticResource Text.Secondary}" Margin="8,28,0,0" Text="No backups yet."
                                           IsHitTestVisible="False"
                                           Visibility="{Binding HasBackups, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                            </Grid>
                            </DockPanel>
                        </Expander>

                        <!-- Profiles grid -->
                        <DataGrid x:Name="ProfilesGrid" Margin="0,2,0,0"
                                  ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                  PreviewKeyDown="ProfilesGrid_PreviewKeyDown"
                                  MouseDoubleClick="ProfilesGrid_MouseDoubleClick">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Active" Binding="{Binding IsActive, Converter={StaticResource ActiveMarker}}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Last written" Binding="{Binding LastWriteUtc, Converter={StaticResource LocalTime}}" Width="140" />
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeBytes, Converter={StaticResource HumanSize}}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="Margin" Value="0,0,6,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Files" Binding="{Binding FileCount}" Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="Margin" Value="0,0,6,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
